# ---------------------------------------------------------------------------
# POKETRAKO — Frontend environment variables
# Copy this file to `.env` and adjust if your backend runs elsewhere.
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# Never put secrets here — this file ends up in the client bundle.
# ---------------------------------------------------------------------------

# Base URL of the POKETRAKO Express API, including the /api prefix.
VITE_API_URL="http://localhost:5000/api"
