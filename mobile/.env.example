# ---------------------------------------------------------------------------
# POKETRAKO Mobile — Environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# Base URL of the POKETRAKO Express API (without /api suffix).
# Examples:
#   Production:   https://poketrako-api.onrender.com
#   Local (emulator):   http://10.0.2.2:5000
#   Local (physical device): http://192.168.x.x:5000
#   Local (iOS simulator):  http://localhost:5000
#
# The /api prefix is added automatically by the API client.
EXPO_PUBLIC_API_URL=