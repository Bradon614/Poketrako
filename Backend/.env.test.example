# ---------------------------------------------------------------------------
# POKETRAKO — Test environment variables
# Copy this file to `.env.test` and adjust if needed. Never commit `.env.test`.
#
# The test database must exist and be migrated before running tests:
#   createdb poketrako_test
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/poketrako_test?schema=public" npx prisma migrate deploy
# ---------------------------------------------------------------------------

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/poketrako_test?schema=public"
JWT_SECRET="test-secret-do-not-use-in-production"
FRONTEND_URL="http://localhost:5173"
