# ---------------------------------------------------------------------------
# POKETRAKO — Backend environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/poketrako?schema=public"

# Secret used to sign JWT access tokens.
# Generate a strong one with: openssl rand -base64 32
JWT_SECRET="change-me-generate-a-long-random-secret"

# Port the Express server listens on. Defaults to 5000 when unset.
PORT=5000

# Origin allowed to call this API (CORS). Must match the frontend's exact
# origin (scheme + host + port), no trailing slash. Defaults to the Vite dev
# server if unset.
FRONTEND_URL="http://localhost:5173"

# Set to "true" only when running behind a reverse proxy (Render, most PaaS
# hosts). Needed for express-rate-limit to read the real client IP from
# X-Forwarded-For instead of the proxy's. Leave unset for local development.
# TRUST_PROXY="true"
